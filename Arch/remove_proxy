#!/bin/bash
# Author: Surya-Raghuram [GitHub: Surya-Raghuram]
# Description: Disable proxy everywhere (CLI, pacman, KDE Plasma, browsers)

echo "== Disable Proxy =="

# Don't run as root
if (( $EUID == 0 )); then
    echo "❌ Please DON'T run as root!"
    exit 1
fi

###############################################################################
# 1. Environment variables
###############################################################################
echo "→ Removing environment proxy"
sudo sed -i '/_proxy/d;/_PROXY/d' /etc/environment
echo "done."

###############################################################################
# 2. Pacman
###############################################################################
echo "→ Removing pacman proxy"
sudo sed -i '/ProxyServer/d' /etc/pacman.conf
echo "done."

###############################################################################
# 3. Yay
###############################################################################
echo "→ Removing yay proxy"
sed -i '/proxy/d' ~/.config/yay/config.json 2>/dev/null || true
echo "done."

###############################################################################
# 4. KDE Plasma (for browsers & GUI apps)
###############################################################################
echo "→ Disabling KDE Plasma proxy"
cat > ~/.config/kioslaverc <<EOF
[Proxy Settings]
ProxyType=0
EOF
qdbus org.kde.kded6 /kded reconfigure
echo "done."

###############################################################################
# 5. Other tools
###############################################################################
echo "→ Removing git proxy"
git config --global --unset http.proxy 2>/dev/null || true
git config --global --unset https.proxy 2>/dev/null || true
echo "done."

echo "→ Removing npm proxy"
npm config delete proxy || true
npm config delete https-proxy || true
echo "done."

echo "→ Removing snap proxy"
sudo snap unset system proxy.http || true
sudo snap unset system proxy.https || true
echo "done."

###############################################################################
# Finish
###############################################################################
echo ""
echo "✅ Proxy disabled everywhere"
