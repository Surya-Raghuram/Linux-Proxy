#!/bin/bash
# Author: Surya-Raghuram [GitHub: Surya-Raghuram]
# Description: Enable IIITA campus proxy everywhere (CLI, pacman, KDE Plasma, browsers)

echo "== Enable Proxy =="

# Don't run as root
if (( $EUID == 0 )); then
    echo "❌ Please DON'T run as root!"
    exit 1
fi

read -p "Proxy host (e.g., 172.31.2.3): " proxy
read -p "Proxy username: " proxy_username
read -s -p "Proxy password: " proxy_password
echo ""

proxy_url="http://$proxy_username:$proxy_password@$proxy:8080/"

###############################################################################
# 1. Environment variables (system-wide CLI apps)
###############################################################################
echo "→ Setting environment variables"
sudo sed -i '/_proxy/d;/_PROXY/d' /etc/environment
sudo sh -c "cat >> /etc/environment <<EOF

http_proxy=$proxy_url
https_proxy=$proxy_url
ftp_proxy=$proxy_url
HTTP_PROXY=$proxy_url
HTTPS_PROXY=$proxy_url
FTP_PROXY=$proxy_url
EOF"
echo "done."

###############################################################################
# 2. Pacman
###############################################################################
echo "→ Setting pacman proxy"
sudo sed -i '/ProxyServer/d' /etc/pacman.conf
sudo sh -c "echo 'ProxyServer = $proxy_url' >> /etc/pacman.conf"
echo "done."

###############################################################################
# 3. Yay (AUR helper)
###############################################################################
echo "→ Setting yay proxy"
mkdir -p ~/.config/yay
cat > ~/.config/yay/config.json <<EOF
{
  "proxy": "$proxy_url"
}
EOF
echo "done."

###############################################################################
# 4. KDE Plasma (for browsers & GUI apps)
# KDE stores proxy settings in ~/.config/kioslaverc
###############################################################################
echo "→ Setting KDE Plasma proxy"
cat > ~/.config/kioslaverc <<EOF
[Proxy Settings]
ProxyType=1
httpProxy=$proxy_url
httpsProxy=$proxy_url
ftpProxy=$proxy_url
EOF
# Reload KDE proxy settings (important for Firefox/Chromium/Discover etc.)
qdbus org.kde.kded6 /kded reconfigure
echo "done."

###############################################################################
# 5. Other tools (git, npm, snap)
###############################################################################
echo "→ Setting proxy for git"
git config --global http.proxy "$proxy_url"
git config --global https.proxy "$proxy_url"
echo "done."

echo "→ Setting proxy for npm"
npm config set proxy "$proxy_url"
npm config set https-proxy "$proxy_url"
echo "done."

echo "→ Setting proxy for snap"
sudo snap set system proxy.http="$proxy_url"
sudo snap set system proxy.https="$proxy_url"
echo "done."

###############################################################################
# Finish
###############################################################################
echo ""
echo "✅ Proxy applied everywhere ($proxy) with username: $proxy_username"
echo "ℹ️  Logout/reboot if some apps don't pick it up."
